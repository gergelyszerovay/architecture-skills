{
  "name": "example",
  "version": "0.1.0",
  "description": "A Node package made from the node-block-architecture template.",
  "type": "module",
  "engines": { "node": ">=24" },
  "architecture": {
    "profile": "node-block-architecture",
    "coverage": "specified"
  },
  "imports": {
    "#libs/*/testing": "./libs/*/src/testing.ts",
    "#libs/*": "./libs/*/src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@gergelyszerovay/architecture-skills": "$SELF_VERSION",
    "@gergelyszerovay/markdown-schema": "^0.13.0",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
