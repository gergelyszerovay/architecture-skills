{
  "name": "node-block-reference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "architecture": {
    "profile": "node-block-architecture"
  },
  "imports": {
    "#libs/*/testing": "./libs/*/src/testing.ts",
    "#libs/*": "./libs/*/src/index.ts"
  },
  "bin": {
    "fs-tools": "./dist/cli.main.mjs",
    "fs-tools-mcp": "./dist/mcp.main.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publint": "publint --strict",
    "lint:tsdoc": "node ../../../architecture-profile/scripts/check-tsdoc-tags.mjs .",
    "lint:placement": "node ../../../architecture-profile/scripts/check-block-placement.mjs ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@trpc/server": "^11.19.0",
    "awilix": "^13.0.5",
    "citty": "^0.2.2",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gergelyszerovay/architecture-skills": "^0.2.0",
    "@eslint/js": "^10",
    "@types/node": "^24.19.2",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsdoc": "^64",
    "eslint-plugin-n": "^18",
    "eslint-plugin-tsdoc": "^0.5.3",
    "prettier": "^3",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8",
    "vitest": "^4.1.5"
  }
}
